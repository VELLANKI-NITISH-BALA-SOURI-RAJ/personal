# Copy this file to .env and fill in your real values
# Get your Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx

# Your internal/VPN PNA Viewer URL
PNA_VIEWER_URL=https://your-internal-domain/pna-viewer

# Optional: basic auth / login creds if the screen requires login first
PNA_USERNAME=
PNA_PASSWORD=
